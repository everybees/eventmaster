# Copy to .env for local development (`npm run dev` / `npm run dev:web` read it; never commit .env).

# MongoDB. Locally: `npm run db:local` starts one at this address.
# On Netlify, set these in Site configuration → Environment variables, using an Atlas user with
# read on `events` and readWrite on `interactions` + `userEventState`. The crawler has its own
# user (readWrite on `events` + `runs`), stored as the GitHub secret MONGODB_CRAWLER_URI.
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=wpg_events

# Optional: Ticketmaster events (free key at developer.ticketmaster.com). Crawler only.
TICKETMASTER_API_KEY=

# Optional: also crawl Eventbrite. It refuses data-centre addresses (so it's off on GitHub Actions) but works
# from a home connection. Crawler only.
# CRAWL_EVENTBRITE=1

# Optional: affiliate tracking for the "Get tickets" button (API only). JSON: seller domain → the program's
# tracking link, with {url} where the URL-encoded event page goes. See README → Tickets.
# AFFILIATE_LINKS={"ticketmaster.ca":"https://<tracking link from the program>?u={url}"}
AFFILIATE_LINKS=

# Who runs the app and where privacy questions go, shown in the privacy notice. Set them in Netlify's
# environment variables (they're built into the page, so they're public, but they stay out of the repo).
VITE_OPERATOR_NAME=
VITE_PRIVACY_EMAIL=

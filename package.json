{
  "name": "wpg-events",
  "private": true,
  "type": "module",
  "description": "Swipe through what's on in Winnipeg: crawler (Python) + API (Netlify Functions) + PWA (Vite/React)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "netlify dev",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mts",
    "db:local": "node scripts/db-local.mts",
    "db:setup": "node scripts/setup-db.mts",
    "metrics": "node --env-file-if-exists=.env scripts/metrics.mts",
    "job:stats": "node --env-file-if-exists=.env scripts/jobs.mts stats",
    "job:reminders": "node --env-file-if-exists=.env scripts/jobs.mts reminders"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "mongodb": "^7.9.1",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "mongodb-memory-server": "^11.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
